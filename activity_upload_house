<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgHousePreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:background="#DDDDDD" />

    <Button
        android:id="@+id/btnSelectImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select House Image"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etHouseLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="House Location (e.g. Kilimani)"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etHousePrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price (e.g. KSh 50,000)"
        android:layout_marginTop="8dp" />

    <Spinner
        android:id="@+id/spinnerBedrooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etHouseAmenities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amenities (e.g. WiFi, Parking)"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnSubmitHouse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload House"
        android:layout_marginTop="20dp" />

</LinearLayout>
