package com.example.house_hunt;

import android.content.Intent;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;
import android.widget.Toast;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.cardview.widget.CardView;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;

public class MainActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);

        View mainView = findViewById(R.id.main);
        if (mainView != null) {
            ViewCompat.setOnApplyWindowInsetsListener(mainView, (v, insets) -> {
                Insets systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars());
                v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom);
                return insets;
            });
        }

        Button btnAdminPanel = findViewById(R.id.btnAdminPanel);
        if (btnAdminPanel != null) {
            btnAdminPanel.setOnClickListener(v -> {
                Intent intent = new Intent(MainActivity.this, AdminDashboardActivity.class);
                startActivity(intent);
            });
        }

        // 1. Navigation Links & Buttons
        TextView tvLogin = findViewById(R.id.tvLogin);
        Button btnViewHouses = findViewById(R.id.btnViewHouses);

        if (tvLogin != null) {
            tvLogin.setOnClickListener(v -> {
                Intent intent = new Intent(MainActivity.this, LoginActivity.class);
                startActivity(intent);
            });
        }

        if (btnViewHouses != null) {
            btnViewHouses.setOnClickListener(v -> {
                Toast.makeText(MainActivity.this, "Exploring available houses...", Toast.LENGTH_SHORT).show();
            });
        }

        // 2. House Cards (Updated drawable names with underscores to match your project files)
        CardView card1 = findViewById(R.id.card1);
        CardView card2 = findViewById(R.id.card2);
        CardView card3 = findViewById(R.id.card3);

        if (card1 != null) {
            card1.setOnClickListener(v -> {
                Intent intent = new Intent(MainActivity.this, HouseDetailActivity.class);
                intent.putExtra("title", "Luxury Apartment");
                intent.putExtra("price", "KSh 150,000 / month");
                intent.putExtra("location", "Kilimani, Nairobi");
                intent.putExtra("amenities", "• Swimming Pool\n• 24/7 Security and CCTV\n• Ample Parking\n• Backup Generator");
                intent.putExtra("image", R.drawable.house_1);
                startActivity(intent);
            });
        }

        if (card2 != null) {
            card2.setOnClickListener(v -> {
                Intent intent = new Intent(MainActivity.this, HouseDetailActivity.class);
                intent.putExtra("title", "Garden Estate Unit");
                intent.putExtra("price", "KSh 85,000 / month");
                intent.putExtra("location", "Karen, Nairobi");
                intent.putExtra("amenities", "• Private Garden\n• Gated Community\n• Borehole Water\n• Pet Friendly");
                intent.putExtra("image", R.drawable.house_2);
                startActivity(intent);
            });
        }

        if (card3 != null) {
            card3.setOnClickListener(v -> {
                Intent intent = new Intent(MainActivity.this, HouseDetailActivity.class);
                intent.putExtra("title", "Classic Brick Home");
                intent.putExtra("price", "KSh 45,000 / month");
                intent.putExtra("location", "Ruiru / Thika Road");
                intent.putExtra("amenities", "• Spacious Compound\n• Perimeter Wall\n• Water Storage Tank\n• Quiet Neighborhood");
                intent.putExtra("image", R.drawable.house_3);
                startActivity(intent);
            });
        }
    }
}
