package com.example.house_hunt;

import android.content.Intent;
import android.os.Bundle;
import android.widget.Button;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class HomeActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // --- 1. ADMIN CHECK ---
        boolean isAdmin = getIntent().getBooleanExtra("IS_ADMIN", false);
        if (isAdmin) {
            Intent adminIntent = new Intent(HomeActivity.this, AdminDashboardActivity.class);
            startActivity(adminIntent);
            finish();
            return;
        }

        setContentView(R.layout.activity_home);

        // --- 2. SCROLL TO HOUSES FUNCTIONALITY ---
        Button btnViewHouses = findViewById(R.id.btnViewHouses);
        ScrollView scrollView = findViewById(R.id.scrollView);
        TextView sectionAvailableHouses = findViewById(R.id.sectionAvailableHouses);

        if (btnViewHouses != null && scrollView != null && sectionAvailableHouses != null) {
            btnViewHouses.setOnClickListener(v -> {
                scrollView.smoothScrollTo(0, sectionAvailableHouses.getTop());
            });
        }

        // --- 3. LOGOUT FUNCTIONALITY ---
        Button btnUserLogout = findViewById(R.id.btnUserLogout);
        if (btnUserLogout != null) {
            btnUserLogout.setOnClickListener(v -> {
                Intent intent = new Intent(HomeActivity.this, LoginActivity.class);
                intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
                startActivity(intent);
                finish();
            });
        }

        // --- 4. BOOK VIEWING BUTTONS ---
        setupBookViewingButtons();
    }

    private void setupBookViewingButtons() {
        int[] bookButtonIds = {
                R.id.btnBook1, R.id.btnBook2, R.id.btnBook3, R.id.btnBook4, R.id.btnBook5,
                R.id.btnBook6, R.id.btnBook7, R.id.btnBook8, R.id.btnBook9, R.id.btnBook10
        };

        for (int i = 0; i < bookButtonIds.length; i++) {
            final int houseNumber = i + 1;
            Button btnBook = findViewById(bookButtonIds[i]);
            if (btnBook != null) {
                btnBook.setOnClickListener(v -> {
                    Toast.makeText(HomeActivity.this, "Viewing booked successfully for House " + houseNumber + "!", Toast.LENGTH_SHORT).show();
                });
            }
        }
    }
}
