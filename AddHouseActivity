package com.example.house_hunt; // Ensure this matches your project's actual package name

import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class AddHouseActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_add_house);

        EditText etTitle = findViewById(R.id.etTitle);
        EditText etLocation = findViewById(R.id.etLocation);
        EditText etPrice = findViewById(R.id.etPrice);
        EditText etBedrooms = findViewById(R.id.etBedrooms);
        EditText etImageName = findViewById(R.id.etImageName);
        Button btnSubmitHouse = findViewById(R.id.btnSubmitHouse);

        btnSubmitHouse.setOnClickListener(v -> {
            String title = etTitle.getText().toString().trim();
            String location = etLocation.getText().toString().trim();
            String price = etPrice.getText().toString().trim();
            String bedrooms = etBedrooms.getText().toString().trim();
            String imageName = etImageName.getText().toString().trim();

            // Included imageName in the validation check
            if (title.isEmpty() || location.isEmpty() || price.isEmpty() || bedrooms.isEmpty() || imageName.isEmpty()) {
                Toast.makeText(this, "Please fill in all property fields", Toast.LENGTH_SHORT).show();
            } else {
                Toast.makeText(this, "House listing uploaded successfully!", Toast.LENGTH_LONG).show();
                finish();
            }
        });
    }
}
