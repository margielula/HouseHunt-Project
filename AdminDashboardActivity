package com.example.house_hunt;

import android.content.Intent;
import android.os.Bundle;
import android.widget.Button;
import androidx.appcompat.app.AppCompatActivity;

public class AdminDashboardActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_admin_dashboard);

        Button btnConfirmBookings = findViewById(R.id.btnConfirmBookings);
        if (btnConfirmBookings != null) {
            btnConfirmBookings.setOnClickListener(v -> {
                Intent intent = new Intent(AdminDashboardActivity.this, ConfirmBookingsActivity.class);
                startActivity(intent);
            });
        }

        Button btnManageHouses = findViewById(R.id.btnManageHouses);
        if (btnManageHouses != null) {
            btnManageHouses.setOnClickListener(v -> {
                Intent intent = new Intent(AdminDashboardActivity.this, ManageHousesActivity.class);
                startActivity(intent);
            });
        }

        Button btnUploadHouse = findViewById(R.id.btnUploadHouse);
        if (btnUploadHouse != null) {
            btnUploadHouse.setOnClickListener(v -> {
                Intent intent = new Intent(AdminDashboardActivity.this, UploadHouseActivity.class);
                startActivity(intent);
            });
        }
    }
}
